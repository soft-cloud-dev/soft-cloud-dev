{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoftCloud Web Awesome Component Schema",
  "version": "2.0.0",
  "allowedComponents": ["wa-card", "wa-callout", "wa-button", "wa-icon"],
  "normalization": {
    "cardAppearances": {
      "elevated": "filled-outlined",
      "flat": "plain"
    },
    "calloutAppearances": {
      "soft": "filled-outlined",
      "solid": "filled",
      "outline": "outlined"
    },
    "buttonAppearances": {
      "text": "plain",
      "flat": "plain"
    },
    "buttonVariants": {
      "primary": "brand"
    },
    "buttonSizes": {
      "small": "s",
      "medium": "m",
      "large": "l"
    },
    "iconNames": {
      "info": "circle-info",
      "info-circle": "circle-info"
    },
    "cardSlotAttributes": {
      "header": "with-header",
      "footer": "with-footer",
      "media": "with-media",
      "header-actions": "with-header-actions",
      "footer-actions": "with-footer-actions"
    }
  },
  "definitions": {
    "wa-card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "enum": ["2.0.0"] },
        "component": { "type": "string", "const": "wa-card" },
        "header": { "type": "string" },
        "footer": { "type": "string" },
        "image": { "type": "string" },
        "image_alt": { "type": "string" },
        "appearance": {
          "type": "string",
          "enum": ["accent", "filled", "outlined", "filled-outlined", "plain"]
        },
        "class": { "type": "string" }
      }
    },
    "wa-callout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "enum": ["2.0.0"] },
        "component": { "type": "string", "const": "wa-callout" },
        "variant": {
          "type": "string",
          "enum": ["neutral", "brand", "success", "warning", "danger"]
        },
        "appearance": {
          "type": "string",
          "enum": ["accent", "filled", "outlined", "filled-outlined", "plain"]
        },
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "class": { "type": "string" }
      }
    },
    "wa-button": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "enum": ["2.0.0"] },
        "component": { "type": "string", "const": "wa-button" },
        "variant": {
          "type": "string",
          "enum": ["neutral", "brand", "success", "warning", "danger"]
        },
        "appearance": {
          "type": "string",
          "enum": ["accent", "filled", "outlined", "filled-outlined", "plain"]
        },
        "size": {
          "type": "string",
          "enum": ["xs", "s", "m", "l", "xl"]
        },
        "href": { "type": "string" },
        "target": {
          "type": "string",
          "enum": ["_blank", "_self", "_parent", "_top"]
        },
        "rel": { "type": "string" },
        "disabled": { "type": "boolean" },
        "with-caret": { "type": "boolean" },
        "loading": { "type": "boolean" },
        "pill": { "type": "boolean" },
        "label": { "type": "string" },
        "class": { "type": "string" }
      }
    },
    "wa-icon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "enum": ["2.0.0"] },
        "component": { "type": "string", "const": "wa-icon" },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "family": {
          "type": "string",
          "enum": ["classic", "brands"]
        },
        "variant": {
          "type": "string",
          "enum": ["solid", "regular"]
        },
        "label": { "type": "string" },
        "class": { "type": "string" }
      },
      "required": ["name"]
    }
  }
}
